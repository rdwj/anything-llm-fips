# FIPS-Compliant Containerfile for AnythingLLM
# Targets: Red Hat OpenShift with FIPS 140-2 requirements
# Platform: linux/amd64

# Setup FIPS-compliant base image with Node.js 20
FROM registry.redhat.io/ubi9/nodejs-20:latest AS base

# Build arguments
ARG ARG_UID=1000
ARG ARG_GID=1000

USER root

# Enable FIPS mode
RUN update-crypto-policies --set FIPS

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

# Install system dependencies (UBI/RHEL equivalents)
RUN dnf install -y --allowerasing \
        unzip curl gnupg2 libgfortran libgbm tzdata nmap-ncat \
        cairo pango libX11 libXcomposite libXcursor libXdamage \
        libXext libXi libXrandr libXrender libXScrnSaver libXtst \
        nss cups-libs atk at-spi2-atk gtk3 \
        ca-certificates alsa-lib \
        git gcc-c++ make \
        fontconfig expat dbus-libs nspr && \
    dnf clean all

# Install yarn globally (Node.js comes pre-installed in UBI nodejs image)
RUN npm install -g yarn

# Install uvx (pinned to 0.6.10) for MCP support
# Make non-fatal since MCP is optional
RUN (curl -LsSf https://astral.sh/uv/0.6.10/install.sh | sh && \
    mv /root/.local/bin/uv /usr/local/bin/uv && \
    mv /root/.local/bin/uvx /usr/local/bin/uvx && \
    echo "Installed uvx! $(uv --version)") || echo "WARNING: uvx installation failed, MCP support will be unavailable"

# Create a group and user with specific UID and GID
RUN groupadd -g "$ARG_GID" anythingllm && \
    useradd -l -u "$ARG_UID" -m -d /app -s /bin/bash -g anythingllm anythingllm && \
    mkdir -p /app/frontend/ /app/server/ /app/collector/ && \
    chown -R anythingllm:anythingllm /app

# Copy docker helper scripts
COPY ./docker/docker-entrypoint.sh /usr/local/bin/
COPY ./docker/docker-healthcheck.sh /usr/local/bin/
COPY --chown=anythingllm:anythingllm ./docker/.env.example /app/server/.env

# Ensure the scripts are executable
RUN chmod +x /usr/local/bin/docker-entrypoint.sh && \
    chmod +x /usr/local/bin/docker-healthcheck.sh

# Note: FIPS environment variables are set in production stage only
# to avoid interfering with build processes

#############################################
# FRONTEND BUILD STAGE
#############################################

FROM base AS frontend-build
USER anythingllm
WORKDIR /app

# Set npm cache to writable location
ENV npm_config_cache=/tmp/.npm

COPY --chown=anythingllm:anythingllm ./frontend /app/frontend/
WORKDIR /app/frontend
RUN yarn install --network-timeout 100000 && yarn cache clean
RUN yarn build && \
    cp -r dist /tmp/frontend-build && \
    rm -rf * && \
    cp -r /tmp/frontend-build dist && \
    rm -rf /tmp/frontend-build

WORKDIR /app

#############################################
# BACKEND BUILD STAGE
#############################################

FROM base AS backend-build
USER anythingllm
WORKDIR /app

# Set npm cache to writable location
ENV npm_config_cache=/tmp/.npm

# Install server dependencies
COPY --chown=anythingllm:anythingllm ./server /app/server/
WORKDIR /app/server
RUN yarn install --production --network-timeout 100000 && yarn cache clean

WORKDIR /app

# Install collector dependencies
COPY --chown=anythingllm:anythingllm ./collector/ ./collector/
WORKDIR /app/collector

# Create and set proper permissions for Puppeteer cache
USER root
RUN mkdir -p /tmp/.puppeteer-cache &&     chown -R anythingllm:anythingllm /tmp/.puppeteer-cache
USER anythingllm

ENV PUPPETEER_DOWNLOAD_BASE_URL=https://storage.googleapis.com/chrome-for-testing-public
ENV PUPPETEER_CACHE_DIR=/tmp/.puppeteer-cache
RUN yarn install --production --network-timeout 100000 && yarn cache clean

WORKDIR /app

#############################################
# PRODUCTION ASSEMBLY
#############################################

FROM backend-build AS production-build
WORKDIR /app

# Copy built frontend into server/public
COPY --chown=anythingllm:anythingllm --from=frontend-build /app/frontend/dist /app/server/public

USER root
RUN chown -R anythingllm:anythingllm /app/server && \
    chown -R anythingllm:anythingllm /app/collector && \
    chgrp -R 0 /app && \
    chmod -R g=u /app && \
    chmod -R g+rwx /app/server /app/collector

USER anythingllm

# Setup the environment
ENV NODE_ENV=production
ENV ANYTHING_LLM_RUNTIME=docker
ENV DEPLOYMENT_VERSION=1.9.0-fips

# FIPS-specific environment variables (redundant but explicit)
ENV OPENSSL_FIPS=1
ENV NODE_OPTIONS="--force-fips"

# Setup the healthcheck
HEALTHCHECK --interval=1m --timeout=10s --start-period=1m \
  CMD /bin/bash /usr/local/bin/docker-healthcheck.sh || exit 1

# Run the server
# Clear the S2I entrypoint from base image and use our own
ENTRYPOINT []
CMD ["/bin/bash", "/usr/local/bin/docker-entrypoint.sh"]
